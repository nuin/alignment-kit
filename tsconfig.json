{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "jsx": "react-jsx",
    "allowJs": true, "resolveJsonModule": true,
    "types": ["node", "vite/client"], "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.svelte", "demo/**/*.ts", "examples/**/*", "tests/**/*.ts", "*.config.ts"],
  "exclude": ["dist", "node_modules", "demo-dist"]
}

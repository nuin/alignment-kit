{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alignment Kit viewer configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference for editor completion."
    },
    "height": {
      "type": "number",
      "minimum": 360,
      "maximum": 2000
    },
    "theme": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "colorScheme": {
      "type": "string",
      "minLength": 1
    },
    "colorMode": {
      "enum": [
        "all",
        "reference-differences",
        "reference-matches",
        "consensus-differences",
        "consensus-matches"
      ]
    },
    "matchDisplay": {
      "enum": [
        "letter",
        "dot"
      ]
    },
    "cellWidth": {
      "type": "number",
      "minimum": 3,
      "maximum": 32
    },
    "rowHeight": {
      "type": "number",
      "minimum": 18,
      "maximum": 48
    },
    "labelWidth": {
      "type": "number",
      "minimum": 100,
      "maximum": 420
    },
    "statisticsScope": {
      "enum": [
        "all",
        "filtered"
      ]
    },
    "rulerCoordinates": {
      "enum": [
        "alignment",
        "reference"
      ],
      "description": "Ruler numbering: alignment columns, or ungapped residue numbers of the pinned reference row."
    },
    "workerUrl": {
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolbar": {
          "type": "boolean"
        },
        "tools": {
          "type": "boolean"
        },
        "overview": {
          "type": "boolean"
        },
        "overviewTitle": {
          "type": "boolean"
        },
        "tracks": {
          "type": "boolean"
        },
        "alignment": {
          "type": "boolean"
        },
        "inspector": {
          "type": "boolean"
        },
        "inspectorTabs": {
          "type": "boolean"
        },
        "status": {
          "type": "boolean"
        },
        "statusSummary": {
          "type": "boolean"
        },
        "statusDetails": {
          "type": "boolean"
        },
        "open": {
          "type": "boolean"
        },
        "search": {
          "type": "boolean"
        },
        "colorScheme": {
          "type": "boolean"
        },
        "zoom": {
          "type": "boolean"
        },
        "fit": {
          "type": "boolean"
        },
        "theme": {
          "type": "boolean"
        },
        "inspectorToggle": {
          "type": "boolean"
        },
        "fullscreen": {
          "type": "boolean"
        },
        "export": {
          "type": "boolean"
        },
        "goTo": {
          "type": "boolean"
        },
        "motif": {
          "type": "boolean"
        },
        "order": {
          "type": "boolean"
        },
        "colorMode": {
          "type": "boolean"
        },
        "logoToggle": {
          "type": "boolean"
        },
        "matchDots": {
          "type": "boolean"
        },
        "statisticsScope": {
          "type": "boolean"
        },
        "alphabet": {
          "type": "boolean"
        },
        "rulerCoordinates": {
          "type": "boolean"
        },
        "ruler": {
          "type": "boolean"
        },
        "modalFrequency": {
          "type": "boolean"
        },
        "gapFraction": {
          "type": "boolean"
        },
        "consensus": {
          "type": "boolean"
        },
        "logo": {
          "type": "boolean"
        },
        "reference": {
          "type": "boolean"
        },
        "labels": {
          "type": "boolean"
        },
        "rowNames": {
          "type": "boolean"
        },
        "rowSpecies": {
          "type": "boolean"
        },
        "rowSelection": {
          "type": "boolean"
        },
        "rowPinning": {
          "type": "boolean"
        },
        "labelResize": {
          "type": "boolean"
        },
        "residueLetters": {
          "type": "boolean"
        },
        "annotationMarks": {
          "type": "boolean"
        },
        "selectionOverlay": {
          "type": "boolean"
        },
        "positionTab": {
          "type": "boolean"
        },
        "featuresTab": {
          "type": "boolean"
        },
        "compareTab": {
          "type": "boolean"
        },
        "colorsTab": {
          "type": "boolean"
        },
        "hitsTab": {
          "type": "boolean"
        },
        "pinReference": {
          "type": "boolean"
        },
        "rowFeaturesToggle": {
          "type": "boolean"
        },
        "featureType": {
          "type": "boolean"
        },
        "featureConsequence": {
          "type": "boolean"
        },
        "diseaseFilter": {
          "type": "boolean"
        },
        "phenotypeFilter": {
          "type": "boolean"
        },
        "featurePagination": {
          "type": "boolean"
        },
        "calculateIdentity": {
          "type": "boolean"
        },
        "clearRows": {
          "type": "boolean"
        },
        "messages": {
          "type": "boolean"
        },
        "emptyState": {
          "type": "boolean"
        },
        "entropy": {
          "type": "boolean"
        },
        "quality": {
          "type": "boolean"
        },
        "stockholmTracks": {
          "type": "boolean"
        },
        "rowHiding": {
          "type": "boolean"
        },
        "rowReordering": {
          "type": "boolean"
        },
        "tree": {
          "type": "boolean"
        },
        "columnMasking": {
          "type": "boolean"
        },
        "tooltip": {
          "type": "boolean"
        }
      }
    },
    "worker": {
      "type": "boolean"
    },
    "consensusThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Consensus columns whose modal frequency among non-gap rows is below this become X (protein) or N (DNA/RNA)."
    },
    "fasta": {
      "type": "object",
      "description": "FASTA settings for exports and Ctrl/Cmd+C.",
      "additionalProperties": false,
      "properties": {
        "gaps": {
          "enum": [
            "keep",
            "remove"
          ]
        },
        "letterCase": {
          "enum": [
            "original",
            "upper",
            "lower"
          ]
        },
        "lineWidth": {
          "type": "integer",
          "description": "0 for unwrapped, otherwise 10 to 1000.",
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 10,
              "maximum": 1000
            }
          ]
        },
        "header": {
          "enum": [
            "name",
            "name-species",
            "id-name"
          ]
        },
        "columns": {
          "enum": [
            "all",
            "visible"
          ],
          "description": "visible leaves out columns hidden by column masking in FASTA exports and copy."
        }
      }
    },
    "groupBy": {
      "type": "string",
      "minLength": 1,
      "description": "A row.metadata key, or species, to group rows by."
    },
    "treeWidth": {
      "type": "number",
      "minimum": 0,
      "maximum": 400,
      "description": "Pixel width of the tree column. 0 hides it."
    },
    "urlSync": {
      "type": "boolean",
      "description": "Keep location.hash in sync with the view and apply a link found there on the next load."
    },
    "dragToPan": {
      "type": "boolean",
      "description": "Drag the residue grid to pan. A press that moves under 4 px stays a click. Default true."
    },
    "showLogo": {
      "type": "boolean"
    },
    "showInspector": {
      "type": "boolean"
    },
    "showToolbar": {
      "type": "boolean"
    },
    "logoMode": {
      "enum": [
        "frequency",
        "bits"
      ]
    },
    "conservationWindow": {
      "type": "integer",
      "minimum": 1,
      "maximum": 51,
      "description": "Odd integer: centered moving average for the entropy and quality bars."
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[\\w.:-]{1,64}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "height": {
            "type": "number",
            "minimum": 12,
            "maximum": 120
          },
          "type": {
            "enum": [
              "bar",
              "heatmap",
              "text"
            ]
          },
          "values": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            ]
          },
          "domain": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "color": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hideGapColumns": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "Hide columns whose gap fraction over all rows is at least this value. null turns it off."
    },
    "hideAllGapColumns": {
      "type": "boolean",
      "description": "Hide columns that are gaps in every row."
    },
    "tooltips": {
      "type": "boolean",
      "description": "Show hover cards for residues and annotation marks and pin annotation cards on click. Default true."
    },
    "annotationLinks": {
      "type": "object",
      "description": "URL templates keyed by source or id type (pubmed, evidence, or a source name). Each must be an http or https URL containing {id}.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^https?://.*\\{id\\}"
      }
    }
  }
}

{
  "name": "@nuin/msa-canvas",
  "version": "0.4.0",
  "type": "module",
  "description": "An annotation-aware, virtualized multiple sequence alignment viewer for JavaScript, React and Svelte",
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/USER_GUIDE.md",
    "docs/reference",
    "docs/RELEASE.md",
    "docs/performance.md",
    "docs/benchmark-results.json",
    "docs/screenshots",
    "config",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./svelte/AlignmentViewer.svelte": {
      "types": "./dist/svelte/AlignmentViewer.svelte.d.ts",
      "svelte": "./dist/svelte/AlignmentViewer.svelte",
      "default": "./dist/svelte/AlignmentViewer.svelte"
    },
    "./pavi": {
      "types": "./dist/pavi.d.ts",
      "import": "./dist/pavi.js"
    },
    "./style.css": "./dist/style.css",
    "./config.schema.json": "./config/viewer-config.schema.json",
    "./config.example.json": "./config/viewer-config.example.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:demo": "vite build",
    "test": "vitest run",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test:browser": "playwright test",
    "benchmark": "node --expose-gc scripts/benchmark.mjs",
    "check:package": "node scripts/check-package.mjs",
    "preview:files": "node scripts/preview.mjs",
    "check:datasets": "node scripts/check-datasets.mjs",
    "build:guide": "node scripts/build-guide.mjs",
    "predev": "npm run build:guide",
    "prebuild:demo": "npm run build:guide",
    "prepack": "npm run build",
    "release:check": "npm test && npm run check && npm run build && npm run check:datasets && npm run build:demo && npm run check:package",
    "screenshots": "node scripts/capture-docs.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "marked": "^18.1.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.4.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuin/alignment-kit.git"
  },
  "homepage": "https://bioinformat.org/msa-canvas",
  "keywords": [
    "msa",
    "multiple-sequence-alignment",
    "bioinformatics",
    "dna",
    "rna",
    "protein",
    "react",
    "svelte"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}

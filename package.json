{
  "name": "@nuin/msa-canvas",
  "version": "0.6.0",
  "type": "module",
  "description": "An annotation-aware, virtualized multiple sequence alignment viewer for JavaScript, React, Svelte, Vue and Web Components",
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/USER_GUIDE.md",
    "docs/reference",
    "docs/RELEASE.md",
    "docs/performance.md",
    "docs/benchmark-results.json",
    "docs/browser-benchmark-results.json",
    "docs/screenshots",
    "config",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "msa-canvas": "./bin/msa-canvas.mjs"
  },
  "unpkg": "./dist/msa-canvas.global.js",
  "jsdelivr": "./dist/msa-canvas.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "default": "./dist/svelte.js"
    },
    "./svelte/AlignmentViewer.svelte": {
      "types": "./dist/svelte/AlignmentViewer.svelte.d.ts",
      "svelte": "./dist/svelte/AlignmentViewer.svelte",
      "default": "./dist/svelte/AlignmentViewer.svelte"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./pavi": {
      "types": "./dist/pavi.d.ts",
      "default": "./dist/pavi.js"
    },
    "./worker.js": "./dist/worker.js",
    "./msa-canvas.global.js": "./dist/msa-canvas.global.js",
    "./msa-canvas.worker.js": "./dist/msa-canvas.worker.js",
    "./style.css": "./dist/style.css",
    "./style.inline.css": "./dist/style.inline.css",
    "./config.schema.json": "./config/viewer-config.schema.json",
    "./config.example.json": "./config/viewer-config.example.json",
    "./wire.schema.json": "./config/wire.schema.json",
    "./view-state.schema.json": "./config/view-state.schema.json",
    "./template.html": "./dist/template.html"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/element.js",
    "./dist/msa-canvas.global.js"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:demo": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test",
    "check:quality": "knip && aislop ci",
    "audit:similarity": "node scripts/similarity-audit.mjs",
    "benchmark": "node --expose-gc scripts/benchmark.mjs",
    "benchmark:browser": "npm run build && node scripts/benchmark-browser.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:size": "node scripts/check-size.mjs",
    "preview:files": "node scripts/preview.mjs",
    "check:datasets": "node scripts/check-datasets.mjs",
    "sync:bindings": "node scripts/sync-bindings.mjs",
    "build:guide": "node scripts/build-guide.mjs",
    "docs:api": "typedoc",
    "predev": "npm run build:guide",
    "prebuild:demo": "npm run build:guide",
    "prepack": "npm run build",
    "release:check": "npm test && npm run check && npm run build && npm run check:size && npm run check:datasets && npm run build:demo && npm run check:package",
    "screenshots": "node scripts/capture-docs.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": "^5.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.58.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.12",
    "aislop": "0.22.1",
    "ajv": "8.20.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "knip": "6.46.0",
    "marked": "^18.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.4.6",
    "typedoc": "0.28.20",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue": "^3.5.46"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuin/alignment-kit.git"
  },
  "homepage": "https://bioinformat.org/msa-canvas",
  "keywords": [
    "msa",
    "multiple-sequence-alignment",
    "bioinformatics",
    "dna",
    "rna",
    "protein",
    "react",
    "svelte",
    "vue",
    "web-components",
    "custom-element"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
